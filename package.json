{
  "name": "understand-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fastify/oauth2": "^8.3.0",
    "dotenv": "^18.0.0",
    "fastify": "^5.6.0",
    "mongodb": "^6.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
